{
  "name": "expo-supabase-template",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "description": "GrowLead boilerplate: Expo + Supabase + NativeWind + EAS. Foundation for iOS/Android apps.",
  "scripts": {
    "dev": "expo start",
    "dev:ios": "expo start --ios",
    "dev:android": "expo start --android",
    "dev:web": "expo start --web",
    "prebuild": "expo prebuild",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build:dev": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "build:production": "eas build --profile production --platform ios",
    "build:android:preview": "eas build --profile preview --platform android",
    "build:android:production": "eas build --profile production --platform android",
    "submit:ios": "eas submit --profile production --platform ios --latest",
    "submit:android": "eas submit --profile production --platform android --latest",
    "eas:secrets:push": "bin/eas-secrets.sh",
    "test": "bun test src",
    "test:e2e": "maestro test .maestro/smoke.yaml",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production",
    "doctor": "bin/doctor.sh"
  },
  "dependencies": {
    "@expo/ui": "~56.0.13",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "^3.1.0",
    "@sentry/react-native": "^8.12.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.100.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~56.0.4",
    "expo-application": "~56.0.3",
    "expo-constants": "~56.0.15",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.9",
    "expo-linking": "~56.0.11",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.6",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.21",
    "expo-web-browser": "~56.0.5",
    "i18next": "^26.3.0",
    "intl-pluralrules": "^2.0.1",
    "js-yaml": "^5.2.1",
    "nativewind": "^4.2.4",
    "posthog-react-native": "^4.46.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.6.0",
    "undici": "^8.7.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.3.14",
    "@types/react": "~19.2.2",
    "lefthook": "^2.1.8",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4",
    "typescript": "~6.0.3"
  }
}

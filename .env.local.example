# Supabase — required for app to start
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry mobile (optional — leave empty to disable error tracking)
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (self-hosted Coolify — Petr's instance)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://posthog.growlead.cz

# Apple Developer (for eas submit --platform ios)
APPLE_ID=
ASC_APP_ID=
APPLE_TEAM_ID=

# Google Play (for eas submit --platform android)
# Place service account JSON at ./google-play-service-account.json
